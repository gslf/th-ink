{
  "id": "/th-ink/",
  "name": "th.ink — spazio al pensiero",
  "short_name": "th.ink",
  "description": "Note Markdown locali, ricerca offline e modifica vocale privata. Uno spazio tranquillo per i tuoi pensieri.",
  "lang": "it",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#faf9f6",
  "theme_color": "#faf9f6",
  "categories": [
    "productivity",
    "utilities"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "./screenshots/desktop-en.png",
      "sizes": "1440x960",
      "type": "image/png",
      "form_factor": "wide",
      "label": "English desktop interface with folders and a Markdown note"
    },
    {
      "src": "./screenshots/mobile-en.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "English mobile editor with formatting and voice controls"
    }
  ]
}
