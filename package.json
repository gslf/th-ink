    "test:focus": "node tests/focus-browser.mjs",
    "test:voice:csp": "node tests/voice-csp-browser.mjs",
    "test:voice:ui": "node tests/voice-mode-browser.mjs",
    "test:editor": "node tests/editor-browser.mjs",
    "test:lists": "node tests/lists-browser.mjs",
    "test:shortcuts": "node tests/shortcuts-browser.mjs",
    "test:properties": "node tests/properties-browser.mjs",
    "test:tags:performance": "node tests/tags-performance-browser.mjs",
    "test:emoji": "node tests/emoji-browser.mjs",
    "test:publish": "node tests/publish-browser.mjs"
